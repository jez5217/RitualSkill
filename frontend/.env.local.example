# ===== Demo Mode =====
# Defaults to true (unset = demo) so the app deploys and runs with zero config, no RPC/wallet/
# contract needed — everything is simulated client-side. Set to "false" once you have a live RPC,
# a deployed contract, and a funded testnet wallet to test against.
NEXT_PUBLIC_DEMO_MODE=true

# ===== Chain Connection (public — read by the browser; only used when DEMO_MODE=false) =====
NEXT_PUBLIC_RITUAL_RPC_URL=https://rpc.ritualfoundation.org

# ===== Deployed Contract (only used when DEMO_MODE=false) =====
# Set this after running `forge script script/Deploy.s.sol` in ../contracts
NEXT_PUBLIC_RESEARCH_REGISTRY=0x0000000000000000000000000000000000000000
